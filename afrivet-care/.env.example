# AFRIVet Care — environment variable NAMES only.
# Never put real values in this file. Put real values in .env.local (git-ignored)
# for local work, and in Vercel → Project → Settings → Environment Variables for deploys.
# With every value blank the app runs in demo mode (sample data, no sign-in).

# --- Clerk (authentication) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Neon (Postgres database) ---
DATABASE_URL=

# --- Vercel Blob (file / image uploads) ---
BLOB_READ_WRITE_TOKEN=

# --- Resend (welcome email) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- App ---
NEXT_PUBLIC_APP_URL=
APP_TIMEZONE=
